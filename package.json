{
  "name": "qrstudio",
  "version": "1.0.0",
  "description": "Offline QR & Barcode Generator - Production Ready",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "pod-install": "cd ios && bundle exec pod install",
    "build:ios:release": "cd ios && xcodebuild -workspace QRStudio.xcworkspace -scheme QRStudio -configuration Release archive",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "clean": "react-native clean-project-auto",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.75.4",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "react-native-screens": "^3.34.0",
    "react-native-safe-area-context": "^4.10.9",
    "react-native-gesture-handler": "^2.18.1",
    "react-native-reanimated": "^3.15.1",
    "@shopify/react-native-skia": "^1.3.13",
    "zustand": "^4.5.5",
    "@nozbe/watermelondb": "^0.27.1",
    "@nozbe/with-observables": "^1.6.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-iap": "^12.15.2",
    "react-native-qrcode-svg": "^6.3.1",
    "react-native-barcode-builder": "^2.0.0",
    "react-native-svg": "^15.6.0",
    "react-native-share": "^10.2.1",
    "react-native-pdf": "^6.7.5",
    "react-native-html-to-pdf": "^0.12.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-permissions": "^4.1.5",
    "date-fns": "^3.6.0",
    "uuid": "^10.0.0",
    "immer": "^10.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/runtime": "^7.25.6",
    "@react-native/babel-preset": "^0.75.4",
    "@react-native/eslint-config": "^0.75.4",
    "@react-native/metro-config": "^0.75.4",
    "@react-native/typescript-config": "^0.75.4",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.5",
    "@types/react-test-renderer": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@testing-library/react-native": "^12.6.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.26.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "resolutions": {
    "@types/react": "^18.3.5"
  },
  "packageManager": "npm@10.8.2"
}
